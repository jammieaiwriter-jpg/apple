{
  "templateId": "G1-04-02-a",
  "skillId": "G1-04-02",
  "mode": "reverse",
  "difficulty": 2,
  "stem": "有{total}顆{itemName}，分成{a}顆和幾顆？",
  "params": {
    "total": { "type": "choice", "values": [2, 3, 4, 5] },
    "a": { "type": "int_range", "min": 0, "max": 5 },
    "itemName": { "type": "choice", "values": ["糖果", "積木", "貼紙", "彈珠", "餅乾"] }
  },
  "reject": [
    "a > total",
    "a == 0",
    "a == total",
    "total == 2 * a"
  ],
  "_rejectNote": "a=0 與 a=total 屬於 G1-04-01「0 的概念」的範圍，不在本技能練。total=2a（如 4 分成 2 和 2）排除的原因是：此時「把已知當答案」剛好會答對，那個干擾選項失去診斷意義。",
  "answer": { "formula": "total - a" },
  "distractors": [
    { "formula": "total + a", "why": "把「分成」看成「合起來」，做成了加法" },
    { "formula": "a", "why": "誤把已經知道的那一部分當成答案" },
    { "formula": "total", "why": "沒有扣掉已知的部分，直接把總數當答案" }
  ],
  "hints": [
    "{total}顆{itemName}要分成兩堆，其中一堆已經知道是{a}顆了。",
    "偷偷告訴妳一個方法：用十格框數一數，{total}裡面拿掉{a}，剩下幾格？",
    "{total}可以分成{a}和{answer}。"
  ],
  "figureSpec": { "type": "ten_frame", "filled": "a", "extra": "answer" },
  "verify": "a + answer == total"
}
